// ============================================
// Grafana Alloy - Production Host + Docker Config
// ============================================
// This config collects:
//   - Host system logs (syslog, auth, kernel, journal)
//   - Docker container logs
//   - Node/system metrics
// Sends logs to Loki and metrics to Prometheus.
// ============================================

logging {
  level  = "debug"
  format = "logfmt"
}

// ============================================
// HOST LOGS
// ============================================

// System logs
local.file_match "syslog" {
  path_targets = [
    { __path__ = "/var/log/syslog", job = "syslog" },
    { __path__ = "/var/log/messages", job = "syslog" },
  ]
}

loki.source.file "syslog" {
  targets    = local.file_match.syslog.targets
  forward_to = [loki.process.default.receiver]
}

// Auth logs
local.file_match "auth" {
  path_targets = [
    { __path__ = "/var/log/auth.log", job = "auth" },
    { __path__ = "/var/log/secure", job = "auth" },
  ]
}

loki.source.file "auth" {
  targets    = local.file_match.auth.targets
  forward_to = [loki.process.default.receiver]
}

// Kernel logs
local.file_match "kernel" {
  path_targets = [
    { __path__ = "/var/log/kern.log", job = "kernel" },
  ]
}

loki.source.file "kernel" {
  targets    = local.file_match.kernel.targets
  forward_to = [loki.process.default.receiver]
}

// Systemd journal
loki.source.journal "journal" {
  forward_to = [loki.process.default.receiver]
  labels = {
    job = "journal",
  }
}

// ============================================
// DOCKER CONTAINER LOGS
// ============================================

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker.output
  forward_to = [loki.process.default.receiver]
  labels = {
    job = "docker",
  }
}

// Default pipeline for most logs (Docker + host logs)
loki.process "default" {
  forward_to = [loki.write.default.receiver]

  stage.static_labels {
    values = {
      collector = "alloy",
      environment = "production",   // change if you have multiple envs
    }
  }
}

// ============================================
// FAIL2BAN LOGS
// ============================================

local.file_match "fail2ban" {
  path_targets = [
    { __path__ = "/var/log/fail2ban.log", job = "fail2ban" },
  ]
}

loki.source.file "fail2ban" {
  targets    = local.file_match.fail2ban.targets
  forward_to = [loki.process.fail2ban.receiver]
}

loki.process "fail2ban" {
  forward_to = [loki.write.default.receiver]

  // Parse lines like:
  // 2026-05-02 10:30:00,123 fail2ban.actions [1234]: NOTICE [sshd] Ban 192.168.1.100
  stage.regex {
    expression = "^(?P<timestamp>\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2},\\d+)\\s+fail2ban\\.(?P<component>\\w+)\\s+\\[\\d+\\]:\\s+(?P<level>\\w+)\\s+\\[(?P<jail>[^\\]]+)\\]\\s+(?P<action>Ban|Unban|Found|Ignore)\\s+(?P<ip>\\S+)"
  }

  stage.geoip {
    db     = "/var/lib/GeoIP/GeoLite2-City.mmdb"
    db_type = "city"
    source = "ip"
  }

  stage.timestamp {
    source = "timestamp"
    format = "2006-01-02 15:04:05,000"
  }

  // Promote fields to Loki labels for filtering in Grafana
  stage.labels {
    values = {
      jail                    = null,
      action                  = null,
      ip                      = null,
      geoip_city_name         = null,
      geoip_country_name      = null,
      geoip_country_code      = null,
      geoip_continent_name    = null,
      geoip_continent_code    = null,
      geoip_location_latitude = null,
      geoip_location_longitude = null,
    }
  }

  stage.static_labels {
    values = {
      collector     = "alloy",
      environment   = "production",
      job           = "fail2ban",
    }
  }
}

// ============================================
// LOKI OUTPUT (LOGS)
// ============================================
local.file "loki_api_key" {
  filename  = "/run/secrets/loki_api_key"
  is_secret = true
}

loki.write "default" {
  endpoint {
    url  = sys.env("LOKI_URL")

    headers = {
      "X-API-Key" = convert.nonsensitive(local.file.loki_api_key.content),
    }
  }

  external_labels = {
    host = env("HOSTNAME"),
  }
}

// ============================================
// METRICS - NODE EXPORTER STYLE
// ============================================

prometheus.exporter.unix "node" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"

  disable_collectors = [
    "arp", "bcache", "bonding", "btrfs", "conntrack", "drm",
    "fibrechannel", "infiniband", "ipvs", "lnstat", "mdadm",
    "nfs", "nfsd", "nvme", "powersupplyclass", "pressure",
    "rapl", "schedstat", "selinux", "sockstat", "softnet",
    "tapestats", "thermal_zone", "timex", "udp_queues",
    "xfs", "zfs",
  ]
}

prometheus.scrape "node" {
  targets        = prometheus.exporter.unix.node.targets
  scrape_interval = "30s"
  forward_to     = [prometheus.relabel.node.receiver]
}

prometheus.relabel "node" {
  forward_to = [prometheus.remote_write.default.receiver]

  rule {
    target_label = "instance"
    replacement  = env("HOSTNAME")
  }

  rule {
    target_label = "job"
    replacement  = "node"
  }

  rule {
    target_label = "collector"
    replacement  = "alloy"
  }
}
// ============================================
// Fail2ban METRICS
// ============================================
prometheus.scrape "fail2ban" {
  targets = [
    {
      __address__ = "fail2ban-exporter:9191",
      job         = "fail2ban",
      instance    = env("HOSTNAME"),
    },
  ]

  scrape_interval = "30s"
  forward_to = [prometheus.relabel.fail2ban.receiver]
}

prometheus.relabel "fail2ban" {
  forward_to = [prometheus.remote_write.default.receiver]

  rule {
    target_label = "job"
    replacement  = "fail2ban"
  }

  rule {
    target_label = "instance"
    replacement  = env("HOSTNAME")
  }
}
// ============================================
// PROMETHEUS OUTPUT (METRICS)
// ============================================
local.file "prom_api_key" {
  filename  = "/run/secrets/prom_api_key"
  is_secret = true
}

prometheus.remote_write "default" {
  endpoint {
    url  = sys.env("PROMETHEUS_URL")

    headers = {
      "X-API-Key" = convert.nonsensitive(local.file.prom_api_key.content),
    }
  }
}
