//    { __path__ = "/logs/mariadb/error.log",   job = "mariadb", log_type = "error" },
//  ]
//}

//loki.source.file "mariadb" {
//  targets    = local.file_match.mariadb.targets
//  forward_to = [loki.process.mariadb.receiver]
//}

// ============================================
// LOG PROCESSING
// ============================================

// Default pipeline for most logs (Docker + host logs)
loki.process "default" {
  forward_to = [loki.write.default.receiver]

  stage.static_labels {
    values = {
      collector = "alloy",
      environment = "production",   // change if you have multiple envs
    }
  }
}

// MariaDB pipeline (light normalization)
//loki.process "mariadb" {
//  forward_to = [loki.write.default.receiver]
//
//  stage.static_labels {
//    values = {
//      collector = "alloy",
//      source    = "database",
//      service   = "mariadb",
//    }
//  }

  // Optional: basic extraction (you can expand this)
//  stage.regex {
//    expression = "(?i)Query\\s+(?P<query>.*)"
//  }

//  stage.labels {
//    values = {
//      query = "query",   // becomes a label if you want (be careful with cardinality)
//    }
//  }
//}

// ============================================
// LOKI OUTPUT (LOGS)
// ============================================

loki.write "default" {
  endpoint {
    url = env("LOKI_URL")   
  }

  external_labels = {
    host = env("HOSTNAME"),
  }
}

// ============================================
// METRICS - NODE EXPORTER STYLE
// ============================================

prometheus.exporter.unix "node" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"

  disable_collectors = [
    "arp", "bcache", "bonding", "btrfs", "conntrack", "drm",
    "fibrechannel", "infiniband", "ipvs", "lnstat", "mdadm",
    "nfs", "nfsd", "nvme", "powersupplyclass", "pressure",
    "rapl", "schedstat", "selinux", "sockstat", "softnet",
    "tapestats", "thermal_zone", "timex", "udp_queues",
    "xfs", "zfs",
  ]
}

prometheus.scrape "node" {
  targets        = prometheus.exporter.unix.node.targets
  scrape_interval = "30s"
  forward_to     = [prometheus.relabel.node.receiver]
}

prometheus.relabel "node" {
  forward_to = [prometheus.remote_write.default.receiver]

  rule {
    target_label = "instance"
    replacement  = env("HOSTNAME")
  }

  rule {
    target_label = "job"
    replacement  = "node"
  }

  rule {
    target_label = "collector"
    replacement  = "alloy"
  }
}

// ============================================
// PROMETHEUS OUTPUT (METRICS)
// ============================================

prometheus.remote_write "default" {
  endpoint {
    url = env("PROMETHEUS_URL")   
  }
}

